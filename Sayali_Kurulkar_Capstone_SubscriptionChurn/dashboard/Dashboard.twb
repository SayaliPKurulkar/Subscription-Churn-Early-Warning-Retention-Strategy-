      <aliases enabled='yes' />
      <column caption='Churn Flag' datatype='integer' name='[Calculation_774056233001136130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;cancelled&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Active Users' datatype='integer' name='[Calculation_774056233001889795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_774056233002156036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_774056233001136130]) / COUNTD([user_id])' />
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_774056233002459141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_774056233002156036]' />
      </column>
      <column caption='Payment Failure Flag' datatype='integer' name='[Calculation_774056233002577926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] = &quot;failed&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Payment Failure Rate' datatype='real' name='[Calculation_774056233002848263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_774056233002577926]) / COUNT([payment_id])' />
      </column>
      <column caption='Revenue at Risk' datatype='real' name='[Calculation_774056233004433416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Calculation_774056233001136130] = 1&#13;&#10;THEN [plan_price]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_774056233013698569]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [signup_date])' />
      </column>
      <column caption='Tenure Band' datatype='string' name='[Calculation_774056233015726090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure_days] &lt;= 90 THEN &quot;0-3 Months&quot;&#13;&#10;ELSEIF [tenure_days] &lt;= 180 THEN &quot;3-6 Months&quot;&#13;&#10;ELSEIF [tenure_days] &lt;= 365 THEN &quot;6-12 Months&quot;&#13;&#10;ELSE &quot;12+ Months&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Users' datatype='real' name='[Calculation_774056233018494987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [Calculation_774056233013698569] : COUNTD([user_id]) })' />
      </column>
      <column caption='Renewal Stage' datatype='string' name='[Calculation_774056233019842572]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status] = &quot;active&quot; THEN &quot;Active&quot;&#13;&#10;ELSEIF [status] = &quot;renewed&quot; THEN &quot;Renewed&quot;&#13;&#10;ELSEIF [status] = &quot;cancelled&quot; THEN &quot;Cancelled&quot;&#13;&#10;ELSE &quot;Renewal Due&quot;&#13;&#10;END' />
      </column>
      <column caption='Prediction Result' datatype='string' name='[Calculation_774056233022390286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_774056233001136130] = 1 THEN &quot;Churned&quot;&#13;&#10;ELSE &quot;Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Band' datatype='string' name='[Calculation_774056233023156239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure_days] &lt;= 90 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [tenure_days] &lt;= 180 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Score' datatype='real' name='[Calculation_774056233023967248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tenure_days] &lt;= 90 THEN 0.8&#13;&#10;ELSEIF [tenure_days] &lt;= 180 THEN 0.5&#13;&#10;ELSE 0.2&#13;&#10;END' />
      </column>
      <column caption='Revenue' datatype='integer' name='[Calculation_774056233024241681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100' />
      </column>
